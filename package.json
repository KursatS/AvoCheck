{
  "name": "avocheck",
  "version": "2.6.4",
  "description": "AvoCheck - Garanti Takip & Metin Asistanı",
  "author": "Kürşat Sinan",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "npm run dev",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "vite": "^6.1.1"
  },
  "build": {
    "appId": "com.reccitek.wcheck",
    "productName": "AvoCheck",
    "compression": "normal",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "KursatS",
      "repo": "AvoCheck"
    },
    "files": [
      "out/**/*",
      "assets/logo.png",
      "assets/logo256.ico",
      "assets/logo512.png",
      "assets/sounds/**/*",
      "resources/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md"
    ],
    "icon": "assets/logo256.ico",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AvoCheck",
      "installerIcon": "assets/logo256.ico",
      "uninstallerIcon": "assets/logo256.ico",
      "installerHeaderIcon": "assets/logo256.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "1055",
      "differentialPackage": false,
      "include": "build/installer.nsh"
    },
    "win": {
      "icon": "assets/logo256.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "logo.icns"
    },
    "linux": {
      "icon": "logo.png"
    }
  }
}
